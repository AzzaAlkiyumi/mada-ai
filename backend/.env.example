APP_NAME=Rafeeq
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=assistant
DB_USERNAME=assistant
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Single-page app (React) ---
# Domains whose requests get cookie sessions. Local: the Vite dev server.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# --- Self-hosted model service (llama.cpp llama-server, Ollama, vLLM) ---
# Must be a private address (127.0.0.1 or a private network), never public.
LLM_BASE_URL=http://127.0.0.1:8080/v1
# Same value as llama-server --api-key. Leave empty only for local development.
LLM_API_KEY=
LLM_MODEL=local-model
LLM_CONNECT_TIMEOUT=5
LLM_TIMEOUT=300
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_THINKING=false
LLM_CONTEXT_MESSAGES=20
LLM_CONTEXT_CHARS=24000
LLM_MAX_INPUT_CHARS=16000
LLM_RATE_PER_MINUTE=10
